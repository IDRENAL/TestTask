# Use a unique value with at least 16 characters.
SCRIPT_MANAGER_API_KEY=replace-with-a-long-random-value

# Use a URL-safe random value because it is interpolated into the database DSN.
POSTGRES_PASSWORD=replace-with-a-url-safe-random-value

# Optional host-side settings:
FRONTEND_PORT=8080
BACKEND_PORT=8000
POSTGRES_PORT=15432
SCHEDULER_TIMEZONE=UTC
